<body style="font-family:Segoe UI, Arial; background-color:#f4f6f8; padding:20px;">
    <table style="max-width:700px; margin:auto; background:#ffffff; border-radius:8px; box-shadow:0 0 10px rgba(0,0,0,0.1); border-collapse:collapse;">
        <tr>
