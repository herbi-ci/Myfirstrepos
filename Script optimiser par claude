# Envoi du message SMTP
Send-MailMessage `
    -From $MailFrom `
    -To $MailTo `
    -Subject $MailSubject `
    -Body $mailBody `
    -BodyAsHtml `
    -SmtpServer $SmtpServer `
    -Port $SmtpPort `
    -Attachments $OutputHtml

# Confirmation dans la console
Write-Host "Rapport généré ($OutputHtml) et envoyé à $MailTo" -ForegroundColor Green
