# =================================================
# REPLICATION – VIA FindLastSession (FIABLE)
# =================================================
$replicaJobs = Get-VBRJob | Where-Object { $_.JobType -eq "Replica" }

$replicaStats = foreach ($job in $replicaJobs) {

    $success = 0
    $failed  = 0
    $warning = 0
    $none    = 0
    $total   = 1   # 1 job = 1 résultat

    $lastSession = $job.FindLastSession()

    if ($null -eq $lastSession) {
        $none = 1
    }
    else {
        switch ($lastSession.Result) {
            "Success" { $success = 1 }
            "Failed"  { $failed  = 1 }
            "Warning" { $warning = 1 }
            default   { $none = 1 }
        }
    }

    $percent = if ($success -eq 1) { 100 } else { 0 }

    [PSCustomObject]@{
        Type     = "Replication"
        JobName  = $job.Name
        Success  = $success
        Warning  = $warning
        Failed   = $failed
        None     = $none
        Total    = $total
        Percent  = $percent
    }
}

# KPI globaux Réplication
$rpSuccess = ($replicaStats | Measure-Object Success -Sum).Sum
$rpFailed  = ($replicaStats | Measure-Object Failed  -Sum).Sum
$rpWarning = ($replicaStats | Measure-Object Warning -Sum).Sum
$rpNone    = ($replicaStats | Measure-Object None    -Sum).Sum
$rpTotal   = $replicaStats.Count

$rpPercent = if ($rpTotal -gt 0) {
    [math]::Round(($rpSuccess / $rpTotal) * 100,1)
} else { 0 }
