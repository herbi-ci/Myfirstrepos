# Load Veeam PowerShell module or snap-in
try {
    if (Get-Module -ListAvailable -Name Veeam.Backup.PowerShell) {
        Import-Module Veeam.Backup.PowerShell -ErrorAction Stop
    } elseif (-not (Get-PSSnapin -Name VeeamPSSnapIn -ErrorAction SilentlyContinue)) {
        Add-PSSnapin VeeamPSSnapIn -ErrorAction Stop
    }
} catch {
    Write-Error "Failed to load Veeam PowerShell module/snap-in. Ensure Veeam Backup & Replication console is installed."
    exit 1
}

# Get all replica jobs
$replicaJobs = Get-VBRJob | Where-Object { $_.JobType -eq "Replica" }

if (-not $replicaJobs) {
    Write-Host "No replica jobs found." -ForegroundColor Yellow
    exit 0
}

# Counters
$totalJobs = 0
$successCount = 0
$failCount = 0

foreach ($job in $replicaJobs) {
    $lastSession = $job.FindLastSession()
    if ($lastSession) {
        $totalJobs++
        switch ($lastSession.Result) {
            "Success" { $successCount++ }
            "Failed"  { $failCount++ }
            default   { } # Ignore warnings or other states
        }
    }
}

if ($totalJobs -eq 0) {
    Write-Host "No completed replica job sessions found." -ForegroundColor Yellow
    exit 0
}

# Calculate percentages
$successPercent = [math]::Round(($successCount / $totalJobs) * 100, 2)
$failPercent    = [math]::Round(($failCount / $totalJobs) * 100, 2)

# Output results
Write-Host "===== Replica Job Status Summary =====" -ForegroundColor Cyan
Write-Host "Total Jobs Checked : $totalJobs"
Write-Host "Successful Jobs    : $successCount ($successPercent`%)" -ForegroundColor Green
Write-Host "Failed Jobs        : $failCount ($failPercent`%)" -ForegroundColor Red
