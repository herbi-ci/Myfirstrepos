# =================================================
# PARAMÈTRES
# =================================================
$since       = (Get-Date).AddDays(-30)
$output      = "C:\Temp\Veeam_Health_Dashboard.html"
$historyFile = "C:\Temp\Veeam_KPI_History.csv"

# =================================================
# BACKUP DISQUE
# =================================================
$backupStats = Get-VBRBackupSession |
Where-Object { $_.CreationTime -ge $since -and $_.JobType -eq "Backup" } |
Group-Object JobName |
ForEach-Object {
    $success = ($_.Group | Where-Object Result -eq "Success").Count
    $failed  = ($_.Group | Where-Object Result -eq "Failed").Count
    $warning = ($_.Group | Where-Object Result -eq "Warning").Count
    $total   = $_.Count
    [PSCustomObject]@{
        Type="Backup"; JobName=$_.Name
        Success=$success; Warning=$warning; Failed=$failed; Total=$total
        Percent= if ($total) { [math]::Round(($success/$total)*100,1) } else {0}
    }
}

$bkSuccess = ($backupStats | Measure-Object Success -Sum).Sum
$bkTotal   = ($backupStats | Measure-Object Total -Sum).Sum
$bkPercent = if ($bkTotal) { [math]::Round(($bkSuccess/$bkTotal)*100,1) } else {0}

# =================================================
# REPLICATION
# =================================================
$replicaStats = Get-VBRBackupSession |
Where-Object { $_.CreationTime -ge $since -and $_.JobType -eq "Replica" } |
Group-Object JobName |
ForEach-Object {
    $success = ($_.Group | Where-Object Result -eq "Success").Count
    $failed  = ($_.Group | Where-Object Result -eq "Failed").Count
    $warning = ($_.Group | Where-Object Result -eq "Warning").Count
    $total   = $_.Count
    [PSCustomObject]@{
        Type="Replica"; JobName=$_.Name
        Success=$success; Warning=$warning; Failed=$failed; Total=$total
        Percent= if ($total) { [math]::Round(($success/$total)*100,1) } else {0}
    }
}

$rpSuccess = ($replicaStats | Measure-Object Success -Sum).Sum
$rpTotal   = ($replicaStats | Measure-Object Total -Sum).Sum
$rpPercent = if ($rpTotal) { [math]::Round(($rpSuccess/$rpTotal)*100,1) } else {0}

# =================================================
# TAPE BACKUP
# =================================================
$tapeSessions = Get-VBRTapeJob | ForEach-Object {
    Get-VBRTapeBackupSession -Job $_
} | Where-Object { $_.CreationTime -ge $since }

$tapeStats = $tapeSessions |
Group-Object Name |
ForEach-Object {
    $success = ($_.Group | Where-Object Result -eq "Success").Count
    $failed  = ($_.Group | Where-Object Result -eq "Failed").Count
    $warning = ($_.Group | Where-Object Result -eq "Warning").Count
    $total   = $_.Count
    [PSCustomObject]@{
        Type="Tape"; JobName=$_.Name
        Success=$success; Warning=$warning; Failed=$failed; Total=$total
        Percent= if ($total) { [math]::Round(($success/$total)*100,1) } else {0}
    }
}

$tpSuccess = ($tapeStats | Measure-Object Success -Sum).Sum
$tpTotal   = ($tapeStats | Measure-Object Total -Sum).Sum
$tpPercent = if ($tpTotal) { [math]::Round(($tpSuccess/$tpTotal)*100,1) } else {0}

# =================================================
# KPI REPOSITORY
# =================================================
$repoStats = Get-VBRBackupRepository | ForEach-Object {
    $cap = [math]::Round($_.Capacity/1GB,1)
    $free= [math]::Round($_.FreeSpace/1GB,1)
    $used= $cap - $free
    [PSCustomObject]@{
        Name=$_.Name; CapacityGB=$cap; UsedGB=$used; FreeGB=$free
        PercentUsed= if ($cap) { [math]::Round(($used/$cap)*100,1) } else {0}
    }
}

# =================================================
# KPI MEDIA POOL
# =================================================
$mediaPoolStats = Get-VBRTapeMediaPool | ForEach-Object {
    $media = Get-VBRTapeMedium -MediaPool $_
    $total = [math]::Round(($media | Measure Capacity -Sum).Sum/1GB,1)
    $free  = [math]::Round(($media | Measure FreeSpace -Sum).Sum/1GB,1)
    [PSCustomObject]@{
        MediaPool=$_.Name; TotalGB=$total; UsedGB=($total-$free); FreeGB=$free
        PercentUsed= if ($total) { [math]::Round((($total-$free)/$total)*100,1) } else {0}
    }
}

# =================================================
# BANDES EXPIRÉES
# =================================================
$expiredTapes = Get-VBRTapeMedium | Where-Object IsExpired |
Select Name,Barcode,MediaPoolName,ExpirationDate

# =================================================
# HISTORIQUE KPI (CSV)
# =================================================
$entry = [PSCustomObject]@{
    Date=(Get-Date -Format "yyyy-MM-dd")
    Backup=$bkPercent; Replica=$rpPercent; Tape=$tpPercent
}
if (-not (Test-Path $historyFile)) {
    $entry | Export-Csv $historyFile -NoTypeInformation
} else {
    $entry | Export-Csv $historyFile -Append -NoTypeInformation
}

$hist = Import-Csv $historyFile
$dates = ($hist.Date | ForEach-Object {"'$_'"}) -join ","
$bkD   = ($hist.Backup) -join ","
$rpD   = ($hist.Replica) -join ","
$tpD   = ($hist.Tape) -join ","

# =================================================
# HTML + COURBES
# =================================================
$html = @"
<html><head>
<title>Veeam Health Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
body{font-family:Segoe UI;background:#f4f6f8}
table{width:90%;margin:auto;border-collapse:collapse}
th,td{padding:8px;border-bottom:1px solid #ddd}
th{background:#2c3e50;color:white}
.green{color:#00B336;font-weight:bold}
.red{color:#E31E24;font-weight:bold}
</style></head><body>

<h1 style="text-align:center">Veeam Infrastructure Health</h1>

<h2 style="text-align:center">Historique des taux de succès</h2>
<canvas id="kpiChart" style="width:90%;max-width:900px;margin:auto"></canvas>

<script>
new Chart(document.getElementById('kpiChart'),{
 type:'line',
 data:{
  labels:[$dates],
  datasets:[
   {label:'Backup',data:[$bkD],tension:0.3},
   {label:'Replica',data:[$rpD],tension:0.3},
   {label:'Tape',data:[$tpD],tension:0.3}
  ]
 },
 options:{scales:{y:{min:0,max:100}}}
});
</script>

<h2 style="text-align:center">Utilisation des Repository</h2><table>
<tr><th>Nom</th><th>Capacité</th><th>Utilisé</th><th>Libre</th><th>%</th></tr>
"@

foreach($r in $repoStats){
 $cls=if($r.PercentUsed -lt 80){"green"}else{"red"}
 $html+="<tr><td>$($r.Name)</td><td>$($r.CapacityGB)</td><td>$($r.UsedGB)</td>
<td>$($r.FreeGB)</td><td class='$cls'>$($r.PercentUsed)%</td></tr>"
}

$html+="</table><h2 style='text-align:center'>Utilisation Media Pool</h2><table>
<tr><th>Pool</th><th>Total</th><th>Utilisé</th><th>Libre</th><th>%</th></tr>"

foreach($m in $mediaPoolStats){
 $cls=if($m.PercentUsed -lt 80){"green"}else{"red"}
 $html+="<tr><td>$($m.MediaPool)</td><td>$($m.TotalGB)</td>
<td>$($m.UsedGB)</td><td>$($m.FreeGB)</td>
<td class='$cls'>$($m.PercentUsed)%</td></tr>"
}

$html+="</table><h2 style='text-align:center'>Bandes expirées</h2><table>
<tr><th>Nom</th><th>Barcode</th><th>Media Pool</th><th>Expiration</th></tr>"

foreach($t in $expiredTapes){
 $html+="<tr><td>$($t.Name)</td><td>$($t.Barcode)</td>
<td>$($t.MediaPoolName)</td><td>$($t.ExpirationDate)</td></tr>"
}

$html+="</table></body></html>"

$html | Out-File $output -Encoding UTF8
Write-Host "Dashboard généré : $output" -ForegroundColor Green
