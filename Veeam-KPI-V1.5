# =================================================
# PARAMÈTRES
# =================================================
$since  = (Get-Date).AddDays(-30)
$output = "C:\Temp\Veeam_Health_Dashboard.html"

# =================================================
# BACKUP DISQUE
# =================================================
$backupStats = Get-VBRBackupSession |
Where-Object { $_.CreationTime -ge $since -and $_.JobType -eq "Backup" } |
Group-Object JobName |
ForEach-Object {
    $success = ($_.Group | Where-Object Result -eq "Success").Count
    $failed  = ($_.Group | Where-Object Result -eq "Failed").Count
    $warning = ($_.Group | Where-Object Result -eq "Warning").Count
    $total   = $_.Count

    [PSCustomObject]@{
        Type     = "Backup"
        JobName  = $_.Name
        Success  = $success
        Warning  = $warning
        Failed   = $failed
        Total    = $total
        Percent  = if ($total -gt 0) { [math]::Round(($success / $total) * 100,1) } else { 0 }
    }
}

$bkSuccess = ($backupStats | Measure-Object Success -Sum).Sum
$bkFailed  = ($backupStats | Measure-Object Failed  -Sum).Sum
$bkWarning = ($backupStats | Measure-Object Warning -Sum).Sum
$bkTotal   = $bkSuccess + $bkFailed + $bkWarning
$bkPercent = if ($bkTotal -gt 0) { [math]::Round(($bkSuccess / $bkTotal) * 100,1) } else { 0 }

# =================================================
# REPLICATION
# =================================================
$replicaStats = Get-VBRBackupSession |
Where-Object { $_.CreationTime -ge $since -and $_.JobType -eq "Replica" } |
Group-Object JobName |
ForEach-Object {
    $success = ($_.Group | Where-Object Result -eq "Success").Count
    $failed  = ($_.Group | Where-Object Result -eq "Failed").Count
    $warning = ($_.Group | Where-Object Result -eq "Warning").Count
    $total   = $_.Count

    [PSCustomObject]@{
        Type     = "Replica"
        JobName  = $_.Name
        Success  = $success
        Warning  = $warning
        Failed   = $failed
        Total    = $total
        Percent  = if ($total -gt 0) { [math]::Round(($success / $total) * 100,1) } else { 0 }
    }
}

$rpSuccess = ($replicaStats | Measure-Object Success -Sum).Sum
$rpFailed  = ($replicaStats | Measure-Object Failed  -Sum).Sum
$rpWarning = ($replicaStats | Measure-Object Warning -Sum).Sum
$rpTotal   = $rpSuccess + $rpFailed + $rpWarning
$rpPercent = if ($rpTotal -gt 0) { [math]::Round(($rpSuccess / $rpTotal) * 100,1) } else { 0 }

# =================================================
# TAPE BACKUP
# =================================================
$tapeSessions = Get-VBRTapeJob | ForEach-Object { Get-VBRTapeBackupSession -Job $_ } |
Where-Object { $_.CreationTime -ge $since }

$tapeStats = $tapeSessions |
Group-Object JobName |
ForEach-Object {
    $success = ($_.Group | Where-Object Result -eq "Success").Count
    $failed  = ($_.Group | Where-Object Result -eq "Failed").Count
    $warning = ($_.Group | Where-Object Result -eq "Warning").Count
    $total   = $_.Count

    [PSCustomObject]@{
        Type     = "Tape"
        JobName  = $_.Name
        Success  = $success
        Warning  = $warning
        Failed   = $failed
        Total    = $total
        Percent  = if ($total -gt 0) { [math]::Round(($success / $total) * 100,1) } else { 0 }
    }
}

$tpSuccess = ($tapeStats | Measure-Object Success -Sum).Sum
$tpFailed  = ($tapeStats | Measure-Object Failed -Sum).Sum
$tpWarning = ($tapeStats | Measure-Object Warning -Sum).Sum
$tpTotal   = $tpSuccess + $tpFailed + $tpWarning
$tpPercent = if ($tpTotal -gt 0) { [math]::Round(($tpSuccess / $tpTotal) * 100,1) } else { 0 }

# =================================================
# FONCTION DONUT SVG
# =================================================
function Get-Donut {
param($percent,$label,$threshold=80)
$color = if ($percent -ge $threshold) { "#E31E24" } else { "#00B336" }
$offset = 440 - (440 * $percent / 100)
@"
<svg width="160" height="160">
 <circle cx="80" cy="80" r="70" stroke="#eee" stroke-width="15" fill="none"/>
 <circle cx="80" cy="80" r="70" stroke="$color" stroke-width="15"
  fill="none" stroke-dasharray="440" stroke-dashoffset="$offset"
  transform="rotate(-90 80 80)"/>
 <text x="50%" y="50%" text-anchor="middle" dy=".3em"
  font-size="22" font-weight="bold">$label%</text>
</svg>
"@
}

# =================================================
# FONCTION REPOSITORY USAGE
# =================================================
function Get-VBRRepositoryUsage {
    Get-VBRBackupRepository | ForEach-Object {
        [Veeam.Backup.Core.CBackupRepositoryEx]::SyncSpaceInfoToDb($_, $true)
        $total = $_.GetContainer().CachedTotalSpace.InBytes
        $free  = $_.GetContainer().CachedFreeSpace.InBytes
        $usedPct = if ($total -gt 0) { [math]::Round((($total - $free) / $total) * 100, 1) } else { 0 }
        [PSCustomObject]@{
            Name        = $_.Name
            Host        = ($_.GetHost()).Name
            Path        = $_.Path
            TotalTB     = [math]::Round($total / 1TB, 2)
            FreeTB      = [math]::Round($free  / 1TB, 2)
            UsedPercent = $usedPct
        }
    }
}

$repoStats = Get-VBRRepositoryUsage
$repoUsedAvg = if ($repoStats.Count -gt 0) {
    [math]::Round(($repoStats | Measure-Object UsedPercent -Average).Average, 1)
} else { 0 }

# =================================================
# FONCTION BARRE HORIZONTALE REPO
# =================================================
function Get-RepoBar {
param($usedPercent, $label)
$color = if ($usedPercent -ge 70) { "#E31E24" } else { "#00B336" }
$width  = [math]::Round( ($usedPercent / 100) * 160 )
@"
<svg width="160" height="30">
 <rect width="160" height="20" fill='#eee' rx='5' ry='5'/>
 <rect width="$width" height="20" fill="$color" rx='5' ry='5'/>
 <text x="50%" y="15" text-anchor="middle" alignment-baseline="middle" 
       font-size="12" font-weight="bold" fill="#000">$label ($usedPercent`%)</text>
</svg>
"@
}

# =================================================
# HTML
# =================================================
$html = @"
<html>
<head>
<title>Veeam Health Dashboard</title>
<style>
body { font-family:Segoe UI; background:#f4f6f8 }
.container { display:flex; justify-content:center; gap:40px; flex-wrap:wrap }
.card { background:#fff; padding:20px; border-radius:10px;
        box-shadow:0 0 10px rgba(0,0,0,0.1); text-align:center; width:180px }
table { width:90%; margin:auto; border-collapse:collapse }
th,td { padding:10px; border-bottom:1px solid #ddd }
th { background:#2c3e50; color:white }
.green { color:#00B336; font-weight:bold }
.red { color:#E31E24; font-weight:bold }
</style>
</head>
<body>

<h1 style="text-align:center">Veeam Infrastructure Health</h1>

<div class="container">
 <div class="card">
  <h3>Backup Success</h3>
  $(Get-Donut $bkPercent $bkPercent)
 </div>
 <div class="card">
  <h3>Replication Success</h3>
  $(Get-Donut $rpPercent $rpPercent)
 </div>
 <div class="card">
  <h3>Tape Backup Success</h3>
  $(Get-Donut $tpPercent $tpPercent)
 </div>
 <div class="card">
  <h3>Repository Usage</h3>
  $(
    foreach ($r in $repoStats) { Get-RepoBar $r.UsedPercent $r.Name }
  )
 </div>
</div>

<h2 style="text-align:center;margin-top:40px">Détails Backup (30 jours)</h2>
<table>
<tr><th>Job</th><th>Success</th><th>Warning</th><th>Failed</th><th>%</th></tr>
"@
foreach ($j in $backupStats | Sort-Object Failed -Descending) {
 $cls = if ($j.Percent -ge 80) { "green" } else { "red" }
 $html += "<tr><td>$($j.JobName)</td><td>$($j.Success)</td>
<td>$($j.Warning)</td><td>$($j.Failed)</td>
<td class='$cls'>$($j.Percent)%</td></tr>"
}

$html += "</table>

<h2 style='text-align:center;margin-top:40px'>Détails Replication (30 jours)</h2>
<table>
<tr><th>Job</th><th>Success</th><th>Warning</th><th>Failed</th><th>%</th></tr>
"
foreach ($j in $replicaStats | Sort-Object Failed -Descending) {
 $cls = if ($j.Percent -ge 80) { "green" } else { "red" }
 $html += "<tr><td>$($j.JobName)</td><td>$($j.Success)</td>
<td>$($j.Warning)</td><td>$($j.Failed)</td>
<td class='$cls'>$($j.Percent)%</td></tr>"
}

$html += "</table>

<h2 style='text-align:center;margin-top:40px'>Détails Tape Backup (30 jours)</h2>
<table>
<tr><th>Job</th><th>Success</th><th>Warning</th><th>Failed</th><th>%</th></tr>
"
foreach ($j in $tapeStats | Sort-Object Failed -Descending) {
 $cls = if ($j.Percent -ge 80) { "green" } else { "red" }
 $html += "<tr><td>$($j.JobName)</td><td>$($j.Success)</td>
<td>$($j.Warning)</td><td>$($j.Failed)</td>
<td class='$cls'>$($j.Percent)%</td></tr>"
}

$html += "</table>

<h2 style='text-align:center;margin-top:40px'>Détails Repositories</h2>
<table>
<tr>
 <th>Repository</th>
 <th>Host</th>
 <th>Path</th>
 <th>Total (TB)</th>
 <th>Free (TB)</th>
 <th>Used %</th>
</tr>
"
foreach ($r in $repoStats | Sort-Object UsedPercent -Descending) {
 $cls = if ($r.UsedPercent -ge 70) { "red" } else { "green" }
 $html += "<tr>
 <td>$($r.Name)</td>
 <td>$($r.Host)</td>
 <td>$($r.Path)</td>
 <td>$($r.TotalTB)</td>
 <td>$($r.FreeTB)</td>
 <td class='$cls'>$($r.UsedPercent)%</td>
</tr>"
}

$html += "</table></body></html>"

$html | Out-File $output -Encoding UTF8
Write-Host "Dashboard généré : $output" -ForegroundColor Green
