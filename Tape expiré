# =================================================
# TAPES EXPIRÉES  <<< BLOC AJOUTÉ
# =================================================
$expiredTapes = Get-VBRTapeMedium | Where-Object {
    $_.ExpirationDate -and $_.ExpirationDate -lt (Get-Date)
} | Select-Object `
    @{Name="Tape"; Expression={$_.Name}},
    @{Name="ExpirationDate"; Expression={$_.ExpirationDate}},
    @{Name="PoolName"; Expression={
        (Get-VBRTapeMediaPool | Where-Object { $_.Id -eq $_.MediaPoolId }).Name
    }}




# ===== TABLEAU TAPES EXPIRÉES =====
$html += "<h2 style='text-align:center;margin-top:40px'>Tapes expirées</h2>
<table>
<tr><th>Tape</th><th>Expiration Date</th><th>Pool Name</th></tr>"

foreach ($t in $expiredTapes | Sort-Object ExpirationDate) {
    $html += "<tr>
        <td>$($t.Tape)</td>
        <td>$($t.ExpirationDate.ToString('yyyy-MM-dd'))</td>
        <td>$($t.PoolName)</td>
    </tr>"
}
