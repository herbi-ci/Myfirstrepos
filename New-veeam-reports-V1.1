<#
Veeam KPI Dashboard - PowerShell
Compatible Veeam Backup & Replication 12.3.1.1139
Exécuter manuellement dans PowerShell ISE en tant qu'Administrateur
Remarque: modifier manuellement les paramètres SMTP et $ReportPath en haut du script
#>

# -----------------------------
# CONFIG (à modifier manuellement)
# -----------------------------
$ReportPath = "C:\Reports\Veeam_Dashboard.html"
$ReportTimestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

# SMTP settings (laisser vide/par défaut — modifier avant activation de l'envoi)
$SMTPServer = "smtp.yourdomain.local"
$SMTPPort   = 25
$MailFrom   = "veeam-report@yourdomain.local"
$MailTo     = "admin@yourdomain.local"
$MailSubject = "Veeam KPI Dashboard - $ReportTimestamp"

# Toggle envoi email
$SendInBody      = $false
$SendAsAttachment= $false
# -----------------------------

# -----------------------------
# Helper: Safe invocation wrapper
# -----------------------------
function Safe(& $ScriptBlock) {
    try {
        & $ScriptBlock
    } catch {
        Write-Verbose "Ignored error: $($_.Exception.Message)"
        return $null
    }
}

# -----------------------------
# Charger module Veeam
# -----------------------------
$veeamLoaded = $false
if (Get-Module -ListAvailable -Name "Veeam.Backup.PowerShell") {
    try { Import-Module Veeam.Backup.PowerShell -ErrorAction Stop; $veeamLoaded = $true } catch {}
} else {
    try { Add-PSSnapin -Name VeeamPSSnapIn -ErrorAction Stop; $veeamLoaded = $true } catch {}
}

if (-not $veeamLoaded) { Write-Error "Module Veeam non disponible."; return }

Safe { Connect-VBRServer -Server "localhost" } | Out-Null

# -----------------------------
# Fonctions utilitaires SVG donuts
# -----------------------------
function Get-DonutSVG ($percent, $label, $size=130, $thickness=18, $color="#00B336", $bg="#e9ecef") {
    $r = ($size/2) - ($thickness/2)
    $circ = 2 * [math]::PI * $r
    $offset = $circ * (1 - ($percent/100))
    $labelEsc = [System.Web.HttpUtility]::HtmlEncode($label)
@"<svg width='$size' height='$size' viewBox='0 0 $size $size' xmlns='http://www.w3.org/2000/svg'>
  <g transform='rotate(-90 $($size/2) $($size/2))'>
    <circle cx='$($size/2)' cy='$($size/2)' r='$r' stroke='$bg' stroke-width='$thickness' fill='none' />
    <circle cx='$($size/2)' cy='$($size/2)' r='$r' stroke='$color' stroke-width='$thickness' stroke-dasharray='$circ' stroke-dashoffset='$offset' stroke-linecap='round' fill='none' />
  </g>
  <text x='50%' y='50%' dominant-baseline='middle' text-anchor='middle' font-family='Arial' font-size='14' fill='#222'>$labelEsc</text>
</svg>"@
}

# -----------------------------
# KPI: Backup jobs (30 jours)
# -----------------------------
$since = (Get-Date).AddDays(-30)
$backupSessions = Safe { Get-VBRBackupSession | Where-Object { $_.CreationTime -ge $since } }

$backupKPI = @()
if ($backupSessions) {
    $backupKPI = $backupSessions |
        Group-Object JobName |
        ForEach-Object {
            [PSCustomObject]@{
                JobName  = $_.Name
                Success  = ($_.Group | Where-Object Result -eq "Success").Count
                Failed   = ($_.Group | Where-Object Result -eq "Failed").Count
                Warning  = ($_.Group | Where-Object Result -eq "Warning").Count
                TotalRun = $_.Count
            }
        }
}

$backupTotal    = ($backupKPI | Measure-Object TotalRun -Sum).Sum
$backupSuccess  = ($backupKPI | Measure-Object Success -Sum).Sum
$backupFail     = ($backupKPI | Measure-Object Failed -Sum).Sum
$backupSuccessRate = if ($backupTotal -gt 0) { [math]::Round(($backupSuccess/$backupTotal)*100,1) } else { 0 }

# -----------------------------
# KPI: Replica jobs (LastResult)
# -----------------------------
$replicaJobs = Safe { Get-VBRJob | Where-Object { $_.JobType -eq "Replica" } }

$rpSuccess = ($replicaJobs | Where-Object LastResult -eq "Success").Count
$rpFailed  = ($replicaJobs | Where-Object LastResult -eq "Failed").Count
$rpWarning = ($replicaJobs | Where-Object LastResult -eq "Warning").Count
$rpTotal   = $replicaJobs.Count
$rpPercent = if ($rpTotal -gt 0) { [math]::Round(($rpSuccess / $rpTotal) * 100,1) } else { 0 }

# -----------------------------
# HTML / CSS
# -----------------------------
$veeamGreen = "#00B336"; $veeamRed = "#E31E24"
$style = @"
<style>
body { font-family: Arial; background:#fff; color:#222; margin:20px; }
.h1 { font-size:22px; color:#0b3a2f; }
.kpi-row { display:flex; gap:18px; margin-top:18px; flex-wrap:wrap; }
.card { width:280px; padding:12px; box-shadow:0 1px 5px rgba(0,0,0,0.08); border-radius:8px; background:#fff; }
.card .title { font-weight:700; color:#333; margin-bottom:8px; }
.small { font-size:12px; color:#666; }
.table { width:100%; border-collapse: collapse; margin-top:12px; }
.table th, .table td { border:1px solid #e6e6e6; padding:6px; text-align:left; font-size:13px; }
.badge-red { color:$veeamRed; font-weight:700; }
.badge-green { color:$veeamGreen; font-weight:700; }
.orange { color:#ff9800; font-weight:bold }
.gray { color:#999 }
</style>
"@

$backupSVG  = Get-DonutSVG -percent $backupSuccessRate -label ("$backupSuccessRate`%") -color $veeamGreen
$replicaSVG = Get-DonutSVG -percent $rpPercent -label ("$rpPercent`%") -color (if ($rpPercent -ge 80) { $veeamGreen } else { $veeamRed })

$html = @"
<!doctype html>
<html>
<head><meta charset='utf-8'><title>Veeam KPI Dashboard</title>$style</head>
<body>
  <div class='h1'>Veeam KPI Dashboard</div>
  <div class='small'>Généré le: $ReportTimestamp</div>

  <div class='kpi-row'>
    <div class='card'>
      <div class='title'>Sauvegardes sur disque (30j)</div>
      <div style='display:flex;align-items:center;gap:10px'>
        <div>$backupSVG</div>
        <div>
          <div style='font-size:18px;font-weight:700'>$backupSuccessRate`% <span class='small' style='color:#666'>succès</span></div>
          <div class='small'>Sessions analysées: $backupTotal</div>
        </div>
      </div>
    </div>

    <div class='card'>
      <div class='title'>Réplication</div>
      <div style='display:flex;align-items:center;gap:10px'>
        <div>$replicaSVG</div>
        <div>
          <div style='font-size:18px;font-weight:700'>$rpPercent`% <span class='small' style='color:#666'>succès</span></div>
          <div class='small'>Jobs analysés: $rpTotal</div>
        </div>
      </div>
    </div>
  </div>

  <div class='section'>
    <h3>Détails des jobs de réplication</h3>
    <table class='table'>
      <tr><th>Nom Job</th><th>Status</th></tr>
"@

foreach ($j in $replicaJobs) {
    $status = if ($j.LastResult) { $j.LastResult } else { "Never run" }
    $cls = switch ($status) {
        "Success" { "badge-green" }
        "Warning" { "orange" }
        "Failed"  { "badge-red" }
        default   { "gray" }
    }
    $html += "<tr><td>$($j.Name)</td><td class='$cls'>$status</td></tr>`n"
}

$html += @"
    </table>
  </div>
</body>
</html>
"@

# Write HTML file
$dir = Split-Path -Path $ReportPath -Parent
if (-not (Test-Path $dir)) { New-Item -Path $dir -ItemType Directory -Force | Out-Null }
Set-Content -Path $ReportPath -Value $html -Encoding UTF8

Write-Host "Rapport généré : $ReportPath" -ForegroundColor Green
